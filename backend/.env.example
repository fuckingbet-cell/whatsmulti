# Copy to .env and fill in values from Hostinger hPanel
PORT=3000
NODE_ENV=production

# Hostinger MySQL credentials (hPanel -> Databases -> MySQL)
DB_HOST=localhost
DB_USER=u123456789_multiwa
DB_PASS=YourHostingerDbPassword
DB_NAME=u123456789_multiwa

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_EXPIRES_IN=30d

# CORS — frontend domain on Hostinger
CORS_ORIGIN=https://yourdomain.hostinger.com
